    window.efRestoreTenantContract = function(id, name) {
        if (confirm(`Restore tenant ${name}? This will move the tenant back to active status.`)) {
            const ajaxUrl = '<?php echo admin_url("admin-ajax.php"); ?>';
            const fd = new FormData();
            fd.append('action', 'eftm_restore_tenant_contract');
            fd.append('tenant_id', id);
            fd.append('security', '<?php echo wp_create_nonce("restore_tenant_nonce"); ?>');

            fetch(ajaxUrl, { method: 'POST', body: fd })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    alert('Tenant restored successfully!');
                    if (typeof efCloseTenantHistoryModal === 'function') efCloseTenantHistoryModal();
                    window.location.href = window.location.pathname + '?_t=' + Date.now();
                } else {
                    alert(res.data || 'Failed to restore tenant');
                }
            }).catch(err => { console.error(err); alert('Network error restoring tenant'); });
        }
    };

    window.efCloseTenantHistoryModal = function() {
        const modal = document.getElementById('efTenantHistoryModal');
        if (!modal) return;
        modal.classList.remove('ef-show');
        setTimeout(() => { modal.style.display = 'none'; }, 250);
    };

    window.efDispatchGlobalView = function(tid, historyIndex) {
        if (document.getElementById('efWorkspaceDynamicScreen')) {
            window.dispatchEvent(new CustomEvent('ef_load_tenant', { detail: { id: tid } }));
            document.querySelectorAll('.ef-tenant-card-item').forEach(c => c.classList.remove('ef-active-tenant'));
            const row = document.getElementById('tenant-row-' + tid);
            if (row) row.classList.add('ef-active-tenant');
