    function calculateRenewValues() {
        const startEl = document.getElementById('renew_start_date');
        const monthsEl = document.getElementById('renew_contract_months');
        const rentEl = document.getElementById('renew_total_rent');
        const endEl = document.getElementById('renew_end_date');
        const mRentEl = document.getElementById('renew_monthly_rent');
        if (!startEl || !monthsEl || !rentEl || !endEl || !mRentEl) return;

        const startVal = startEl.value;
        const monthsVal = parseInt(monthsEl.value) || 0;
        const amountVal = parseFloat(rentEl.value) || 0;

        if (startVal && monthsVal > 0) {
            let dt = new Date(startVal);
            if (!isNaN(dt.getTime())) {
                dt.setMonth(dt.getMonth() + monthsVal);
                dt.setDate(dt.getDate() - 1);
                const y = dt.getFullYear();
                const m = String(dt.getMonth() + 1).padStart(2, '0');
                const d = String(dt.getDate()).padStart(2, '0');
                endEl.value = `${y}-${m}-${d}`;
            }
        }

        if (amountVal > 0 && monthsVal > 0) {
            mRentEl.value = (amountVal / monthsVal).toFixed(2);
        } else {
            mRentEl.value = '';
        }
    }

