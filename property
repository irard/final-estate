add_action('wp_ajax_get_properties_dashboard', 'ef_handle_get_properties_dashboard'); 
if (!function_exists('ef_handle_get_properties_dashboard')) { 
function ef_handle_get_properties_dashboard() { 
    check_ajax_referer('ef_property_nonce', 'nonce'); 
    if (!is_user_logged_in()) { 
        wp_send_json_error('Unauthorized.'); 
    } 
 
    $p_query = new WP_Query([ 
        'post_type'        => 'property', 
        'posts_per_page'   => -1, 
        'post_status'      => 'any', 
        'orderby'          => 'date', 
        'order'            => 'DESC', 
        'suppress_filters' => true 
    ]); 
    $properties = $p_query->posts;
 
    if (empty($properties)) { 
        wp_send_json_success([]); 
    } 
 
    $property_ids = wp_list_pluck($properties, 'ID'); 
 
 
    $all_tenants = get_posts([ 
        'post_type'   => 'ef_tenant', 
        'post_status' => 'publish', 
        'numberposts' => -1
    ]); 
 
    $tenants_by_property = []; 
    $all_tenant_ids = []; 
    foreach ($all_tenants as $t) { 
        $t_status = get_post_meta($t->ID, 'tenant_status', true) ?: (function_exists('get_field') ? get_field('tenant_status', $t->ID) : '');
        if ($t_status === 'finished') {
            continue;
        }
        $p_id = ef_get_tenant_property_id($t->ID);
        if ($p_id && in_array($p_id, $property_ids)) {
            $tenants_by_property[$p_id][] = $t; 
        }
        $all_tenant_ids[] = $t->ID; 
    } 
 
 
    $period_data = ef_get_dashboard_period();
    $current_month = $period_data['m']; 
    $current_year  = $period_data['y']; 
    $current_period = $period_data['period'];
 
    $all_payments = get_posts([ 
        'post_type'      => 'payment', 
        'numberposts'    => -1, 
        'post_status'    => ['publish', 'future', 'pending', 'draft', 'private']
    ]); 
 
    $payments_by_tenant = []; 
    $payments_by_property = [];
    foreach ($all_payments as $pay) { 
        if (strpos(ef_get_payment_period($pay->ID), $current_period) === 0) {
            $t_id = ef_get_payment_tenant_id($pay->ID);
            if ($t_id) {
                $payments_by_tenant[$t_id][] = $pay; 
            }
            $p_id = ef_get_payment_property_id($pay->ID);
            if ($p_id) {
                $payments_by_property[$p_id][] = $pay;
            }
        }
    } 
 
    $data = []; 
    foreach ($properties as $p) { 
        $p_tenants = isset($tenants_by_property[$p->ID]) ? $tenants_by_property[$p->ID] : []; 
        $occupied = count($p_tenants); 
 
        $units = 0; 
        if (function_exists('get_field')) { 
            $units = intval(get_field('number_unit', $p->ID)); 
        } 
        if (!$units) { 
            $units = intval(get_post_meta($p->ID, 'number_unit', true)) ?: intval(get_post_meta($p->ID, 'property_units', true)) ?: 0; 
        } 
 
        $expected = ef_clean_amount(get_field('property_rent', $p->ID) ?: get_post_meta($p->ID, 'property_rent', true) ?: get_field('total_contract_amount', $p->ID) ?: get_post_meta($p->ID, 'total_contract_amount', true) ?: get_field('total_rent_cost', $p->ID) ?: get_post_meta($p->ID, 'total_rent_cost', true));

        if ($expected <= 0) {
            foreach ($p_tenants as $t) {
                $rent_val = get_field('total_contract_amount', $t->ID) ?: get_post_meta($t->ID, 'total_contract_amount', true) ?: get_field('total_rent_cost', $t->ID) ?: get_post_meta($t->ID, 'total_rent_cost', true);
                if (!$rent_val) {
                    $rent_val = get_field('monthly_rent', $t->ID) ?: get_post_meta($t->ID, 'monthly_rent', true); 
                }
                $expected += ef_clean_amount($rent_val);
            }
        }

        $collected = 0; 
        $billable_count = 0;
        $progress_sum = 0;

        $p_pay_total = 0;
        $p_payments = isset($payments_by_property[$p->ID]) ? $payments_by_property[$p->ID] : [];
        foreach ($p_payments as $pay) {
            $p_pay_total += ef_clean_amount(get_field('amount_paid', $pay->ID) ?: get_post_meta($pay->ID, 'amount_paid', true));
        }
        $collected = $p_pay_total;

        foreach ($p_tenants as $t) { 
            $rent_val = get_field('monthly_rent', $t->ID) ?: get_post_meta($t->ID, 'monthly_rent', true); 
            $monthly_rent = ef_clean_amount($rent_val);

            if (function_exists("ef_is_tenant_billable") && !ef_is_tenant_billable($t->ID, $current_month, $current_year)) continue; 
            
            $billable_count++;
 
            $t_paid_total = 0;
            $t_payments = isset($payments_by_tenant[$t->ID]) ? $payments_by_tenant[$t->ID] : []; 
            foreach ($t_payments as $pay) { 
                $amount_val = get_field('amount_paid', $pay->ID) ?: get_post_meta($pay->ID, 'amount_paid', true); 
                $t_paid_total += ef_clean_amount($amount_val);
            } 

            if ($monthly_rent > 0) {
                $progress_sum += min(1, $t_paid_total / $monthly_rent);
            } elseif ($t_paid_total > 0) {
                $progress_sum += 1;
            }
        } 
 
        $col_pct = ($billable_count > 0) ? round(($progress_sum / $billable_count) * 100) : 0;

        $p_name = (function_exists('get_field') ? (get_field('add_property', $p->ID) ?: get_field('property_name', $p->ID)) : null) ?: get_post_meta($p->ID, 'add_property', true) ?: get_post_meta($p->ID, 'property_name', true) ?: $p->post_title;
        if (!$p_name) $p_name = 'Property #' . $p->ID;

        $p_address = (function_exists('get_field') ? get_field('add_address', $p->ID) : null) ?: get_post_meta($p->ID, 'add_address', true) ?: get_post_meta($p->ID, 'address', true) ?: 'N/A';

        $tenant_names = [];
        foreach ($p_tenants as $t) {
            if ($t->post_title) {
                $tenant_names[] = $t->post_title;
            }
        }

        $data[] = [ 
            'id'        => $p->ID, 
            'name'      => $p_name, 
            'type'      => function_exists('get_field') ? (get_field('property_type', $p->ID) ?: 'Property') : (get_post_meta($p->ID, 'property_type', true) ?: 'Property'), 
            'units'     => $units, 
            'occupied'  => $occupied, 
            'address'   => $p_address, 
            'expected'  => $expected, 
            'collected' => $collected,
            'col_pct'   => $col_pct,
            'tenants'   => $tenant_names
        ]; 
    } 
    wp_send_json_success($data); 
} 
} 
 
add_action('wp_ajax_get_property_tenants_simple', 'ef_handle_get_property_tenants_simple'); 
if (!function_exists('ef_handle_get_property_tenants_simple')) { 
function ef_handle_get_property_tenants_simple() { 
    check_ajax_referer('ef_property_nonce', 'nonce'); 
    if (!is_user_logged_in()) { 
        wp_send_json_error('Unauthorized.'); 
    } 
 
    $property_id = intval($_POST['property_id'] ?? 0); 
    if (!$property_id) { 
        wp_send_json_error('Property ID missing'); 
    } 
 
    $tenants = get_posts([ 
        'post_type'      => 'ef_tenant', 
        'posts_per_page' => -1, 
        'post_status'    => 'publish', 
    ]); 
 
    $active_data = []; 
    $history_data = [];
    foreach ($tenants as $t) { 
        $tid = $t->ID; 
        $t_prop_id = ef_get_tenant_property_id($tid);
        if ($t_prop_id !== $property_id) {
            continue;
        }
        $rent = function_exists('get_field') ? get_field('monthly_rent', $tid) : get_post_meta($tid, 'monthly_rent', true); 
        $unit = function_exists('get_field') ? get_field('tenant_unit', $tid) : get_post_meta($tid, 'tenant_unit', true); 
        $address = function_exists('get_field') ? get_field('tenant_address', $tid) : get_post_meta($tid, 'tenant_address', true); 
        $status = get_post_meta($tid, 'tenant_status', true) ?: (function_exists('get_field') ? get_field('tenant_status', $tid) : '');
        $start_date = function_exists('get_field') ? get_field('tenant_start', $tid) : get_post_meta($tid, 'tenant_start', true);
        $end_date = function_exists('get_field') ? get_field('tenant_end', $tid) : get_post_meta($tid, 'tenant_end', true);

        $start_fmt = $start_date ? date('m/d/Y', strtotime(str_replace('/', '-', $start_date))) : '';
        $end_fmt = $end_date ? date('m/d/Y', strtotime(str_replace('/', '-', $end_date))) : '';
        $date_range = ($start_fmt && $end_fmt) ? ($start_fmt . ' - ' . $end_fmt) : ($start_fmt ?: $end_fmt);

        $item = [ 
            'id'          => $tid, 
            'name'        => $t->post_title, 
            'unit'        => $unit ?: '1A', 
            'address'     => $address ?: 'N/A', 
            'rent'        => floatval($rent),
            'status'      => $status,
            'date_range'  => $date_range
        ]; 

        if ($status === 'finished') {
            $history_data[] = $item;
        } else {
            $active_data[] = $item;
        }

        // Add past contracts from contract_history backlog if available
        $raw_ch = get_post_meta($tid, 'contract_history', true);
        $ch_list = is_array($raw_ch) ? $raw_ch : (json_decode($raw_ch, true) ?: []);
        if (!empty($ch_list)) {
            foreach ($ch_list as $index => $ch) {
                $ch_start = !empty($ch['tenant_start']) ? date('m/d/Y', strtotime(str_replace('/', '-', $ch['tenant_start']))) : '';
                $ch_end = !empty($ch['tenant_end']) ? date('m/d/Y', strtotime(str_replace('/', '-', $ch['tenant_end']))) : '';
                $ch_range = ($ch_start && $ch_end) ? ($ch_start . ' - ' . $ch_end) : ($ch_start ?: $ch_end);
                $ch_rent = floatval($ch['monthly_rent'] ?? $rent);

                $history_data[] = [
                    'id'            => $tid,
                    'history_index' => $index,
                    'name'          => $t->post_title,
                    'unit'          => $unit ?: '1A',
                    'address'       => $address ?: 'N/A',
                    'rent'          => $ch_rent,
                    'status'        => 'finished',
                    'date_range'    => $ch_range
                ];
            }
        }
    } 
    $raw_m = function_exists('get_field') ? get_field('maintenance_fees', $property_id) : get_post_meta($property_id, 'maintenance_fees', true);
    if (!is_array($raw_m)) {
        $raw_m = [];
    }
    $maintenance_fees = [];
    foreach ($raw_m as $idx => $m) {
        if (is_array($m)) {
            $maintenance_fees[] = [
                'index'   => $idx,
                'fee'     => floatval($m['maintenance_fee'] ?? 0),
                'details' => $m['maintenance_details'] ?? '',
                'date'    => $m['maintenance_date'] ?? ''
            ];
        }
    }

    wp_send_json_success([
        'active'      => $active_data,
        'history'     => $history_data,
        'maintenance' => $maintenance_fees
    ]); 
} 
}

add_action('wp_ajax_add_property_maintenance_fee', 'ef_handle_add_property_maintenance_fee');
if (!function_exists('ef_handle_add_property_maintenance_fee')) {
function ef_handle_add_property_maintenance_fee() {
    check_ajax_referer('ef_property_nonce', 'nonce');
    if (!is_user_logged_in()) wp_send_json_error('Unauthorized');

    $property_id = intval($_POST['property_id'] ?? 0);
    $fee = floatval($_POST['fee'] ?? 0);
    $details = sanitize_text_field($_POST['details'] ?? '');
