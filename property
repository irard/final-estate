add_action('wp_ajax_nopriv_get_tenant_modal_details', 'ef_handle_get_tenant_modal_details'); 
if (!function_exists('ef_handle_get_tenant_modal_details')) { 
function ef_handle_get_tenant_modal_details() { 
    if (!is_user_logged_in()) { 
        wp_send_json_error('Unauthorized.'); 
    } 
 
    $tenant_id = intval($_POST['tenant_id'] ?? 0); 
    if (!$tenant_id) { 
        wp_send_json_error('Tenant ID missing'); 
    } 

    $tenant = get_post($tenant_id);
    if (!$tenant) {
        wp_send_json_error('Tenant not found');
    }

    $tenant_name = $tenant->post_title;
    $status = get_post_meta($tenant_id, 'tenant_status', true) ?: (function_exists('get_field') ? get_field('tenant_status', $tenant_id) : '');
    $monthly_rent = floatval(function_exists('get_field') ? get_field('monthly_rent', $tenant_id) : get_post_meta($tenant_id, 'monthly_rent', true));
    $total_rent_cost = floatval((function_exists('get_field') ? get_field('total_rent_cost', $tenant_id) : null) ?: get_post_meta($tenant_id, 'total_rent_cost', true) ?: (function_exists('get_field') ? get_field('total_contract_amount', $tenant_id) : null) ?: get_post_meta($tenant_id, 'total_contract_amount', true));
    $contract_months = (function_exists('get_field') ? get_field('contract_months', $tenant_id) : null) ?: get_post_meta($tenant_id, 'contract_months', true) ?: (function_exists('get_field') ? get_field('tenant_contract_months', $tenant_id) : null) ?: get_post_meta($tenant_id, 'tenant_contract_months', true) ?: 12;

    $email = (function_exists('get_field') ? get_field('tenant_email', $tenant_id) : null) ?: get_post_meta($tenant_id, 'tenant_email', true) ?: 'None';
    $phone = (function_exists('get_field') ? get_field('tenant_phone', $tenant_id) : null) ?: get_post_meta($tenant_id, 'tenant_phone', true) ?: 'None';
    $address = (function_exists('get_field') ? get_field('tenant_address', $tenant_id) : null) ?: get_post_meta($tenant_id, 'tenant_address', true) ?: 'No Address Provided';
    $start = (function_exists('get_field') ? get_field('tenant_start', $tenant_id) : null) ?: get_post_meta($tenant_id, 'tenant_start', true);
    $end = (function_exists('get_field') ? get_field('tenant_end', $tenant_id) : null) ?: get_post_meta($tenant_id, 'tenant_end', true);
    $unit = (function_exists('get_field') ? get_field('tenant_unit', $tenant_id) : null) ?: get_post_meta($tenant_id, 'tenant_unit', true) ?: '1A';

    $raw_history = get_post_meta($tenant_id, 'contract_history', true);
    $contract_history = is_array($raw_history) ? $raw_history : (json_decode($raw_history, true) ?: []);

    $history_index = isset($_POST['history_index']) && $_POST['history_index'] !== '' ? intval($_POST['history_index']) : -1;
    $is_historical_view = false;

    if ($history_index >= 0 && isset($contract_history[$history_index])) {
        $ch_item = $contract_history[$history_index];
        $start = $ch_item['tenant_start'] ?? $start;
        $end = $ch_item['tenant_end'] ?? $end;
        $monthly_rent = floatval($ch_item['monthly_rent'] ?? $monthly_rent);
        $total_rent_cost = floatval($ch_item['total_rent_cost'] ?? $total_rent_cost);
        $contract_months = intval($ch_item['contract_months'] ?? $contract_months);
        $status = 'finished';
        $is_historical_view = true;
    }

    $prop_field = (function_exists('get_field') ? get_field('property_id', $tenant_id) : null) ?: get_post_meta($tenant_id, 'property_id', true);
    $propId = is_object($prop_field) ? $prop_field->ID : (is_array($prop_field) ? ($prop_field['ID'] ?? $prop_field[0]->ID ?? 0) : intval($prop_field));
    $property_name = $propId ? get_the_title($propId) : 'N/A';

    $total_contract = $total_rent_cost ?: ($monthly_rent * 12);

    // Fetch payment records
    $raw_payment_posts = get_posts([
        'post_type' => 'payment',
        'post_status' => ['publish', 'future', 'pending', 'draft', 'private'],
        'posts_per_page' => -1,
        'orderby' => 'date',
        'order' => 'DESC'
    ]);

    $payment_posts = [];
    foreach ($raw_payment_posts as $raw_p) {
        if (ef_get_payment_tenant_id($raw_p->ID) === intval($tenant_id)) {
            $payment_posts[] = $raw_p;
        }
    }

    $payments = [];
    $total_paid = 0.00;

    foreach ($payment_posts as $p) {
        $pay_id = $p->ID;
        $amt = floatval(str_replace(',', '', (function_exists('get_field') ? get_field('amount_paid', $pay_id) : null) ?: get_post_meta($pay_id, 'amount_paid', true)));
        $raw_date = (function_exists('get_field') ? get_field('date_of_payment', $pay_id) : null) ?: get_post_meta($pay_id, 'date_of_payment', true);
        $cheque_start = (function_exists('get_field') ? get_field('cheque_start_date', $pay_id) : null) ?: get_post_meta($pay_id, 'cheque_start_date', true);
        $cheque_end = (function_exists('get_field') ? get_field('cheque_end_date', $pay_id) : null) ?: get_post_meta($pay_id, 'cheque_end_date', true);

        $pay_ref_date = $cheque_end ?: ($cheque_start ?: $raw_date);
        if ($pay_ref_date) {
            $pay_ts = strtotime(str_replace('/', '-', $pay_ref_date));
            $pay_ymd = $pay_ts ? date('Y-m-d', $pay_ts) : '';
            if ($pay_ymd) {
                if ($is_historical_view) {
                    $s_ts = $start ? strtotime(str_replace('/', '-', $start)) : 0;
                    $e_ts = $end ? strtotime(str_replace('/', '-', $end)) : 0;
                    $start_ymd = $s_ts ? date('Y-m-d', $s_ts) : '';
                    $end_ymd = $e_ts ? date('Y-m-d', $e_ts) : '';
                    if ($start_ymd && $pay_ymd < $start_ymd) continue;
                    if ($end_ymd && $pay_ymd > $end_ymd) continue;
                } else {
                    if ($start) {
                        $s_ts = strtotime(str_replace('/', '-', $start));
                        $start_ymd = $s_ts ? date('Y-m-d', $s_ts) : '';
                        if ($start_ymd && $pay_ymd < $start_ymd) continue;
                    }
                }
            }
        }

        $total_paid += $amt;
        $ts = $raw_date ? strtotime($raw_date) : get_the_date('U', $pay_id);
        $date_fmt = $ts ? date('n/j/Y', $ts) : 'N/A';

        $method = (function_exists('get_field') ? get_field('mode_of_payment', $pay_id) : null) ?: get_post_meta($pay_id, 'mode_of_payment', true) ?: 'Cash';
        $cheque = (function_exists('get_field') ? get_field('transaction_cheque_number', $pay_id) : null) ?: get_post_meta($pay_id, 'transaction_cheque_number', true);
        $period = (function_exists('get_field') ? get_field('payment_period', $pay_id) : null) ?: get_post_meta($pay_id, 'payment_period', true);

        if ($cheque_start && $cheque_end) {
            $period_display = ($cheque_start === $cheque_end) ? $cheque_start : ($cheque_start . ' to ' . $cheque_end);
        } else {
            $period_display = $period ? substr((string)$period, 0, 7) : ($ts ? date('Y-m', $ts) : 'N/A');
        }

        $rv = (function_exists('get_field') ? get_field('receipt_voucher', $pay_id) : null) ?: get_post_meta($pay_id, 'receipt_voucher', true) ?: ('REC-' . str_pad($pay_id, 6, '0', STR_PAD_LEFT));

        $payments[] = [
            'id' => $pay_id,
            'amount' => $amt,
            'period' => $period_display,
            'date' => $date_fmt,
            'method' => $method,
            'cheque' => $cheque ?: '',
            'receipt_voucher' => $rv
        ];
    }

    $balance = max(0, $total_contract - $total_paid);

    $end_ymd = $end ? (function_exists('ef_parse_date_to_ymd') ? ef_parse_date_to_ymd($end) : date('Y-m-d', strtotime(str_replace('/', '-', $end)))) : '';
    if ($status !== 'finished' && $end_ymd && $end_ymd < date('Y-m-d')) {
        $status = 'finished';
    }

    if ($status !== 'finished' && $balance > 0.001) {
        $last_pay_end = function_exists('ef_get_tenant_last_payment_end_date') ? ef_get_tenant_last_payment_end_date($tenant_id) : $start;
        if ($last_pay_end && $last_pay_end < date('Y-m-d')) {
            $status = 'due';
        }
    }

    $start_fmt = $start ? date('m/d/Y', strtotime(str_replace('/', '-', $start))) : 'N/A';
    $end_fmt = $end ? date('m/d/Y', strtotime(str_replace('/', '-', $end))) : 'N/A';

    $raw_history = get_post_meta($tenant_id, 'contract_history', true);
    $contract_history = is_array($raw_history) ? $raw_history : (json_decode($raw_history, true) ?: []);

    wp_send_json_success([
        'id' => $tenant_id,
        'name' => $tenant_name,
        'status' => $status,
        'contract_history' => $contract_history,
        'property_name' => $property_name,
        'unit' => $unit,
        'monthly_rent' => $monthly_rent,
        'total_contract' => $total_contract,
        'total_paid' => $total_paid,
        'balance' => $balance,
        'email' => $email,
        'phone' => $phone,
        'address' => $address,
        'start_date' => $start_fmt,
        'end_date' => $end_fmt,
        'raw_start' => $start,
        'raw_end' => $end,
        'finished_on' => ($is_historical_view) ? ($end_fmt ?: '—') : (
            ($status === 'finished') ? (
                ($fin_date_meta = (function_exists('get_field') ? get_field('tenant_finished_date', $tenant_id) : null) ?: get_post_meta($tenant_id, 'tenant_finished_date', true))
                    ? date('m/d/Y', strtotime(str_replace('/', '-', $fin_date_meta)))
                    : ($end_fmt ?: '—')
            ) : '—'
        ),
        'contract_months' => $contract_months ? ($contract_months . ' Months') : '—',
        'contract_months_num' => intval($contract_months),
        'payments' => $payments
    ]);
}
}
 
