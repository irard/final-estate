            if (tidEl) tidEl.value = d.id;
            if (nameEl) nameEl.innerText = d.name;
            
            let nextStart = new Date();
            if (d.end) {
                let prevEnd = new Date(d.end);
                if (!isNaN(prevEnd.getTime())) {
                    prevEnd.setDate(prevEnd.getDate() + 1);
                    nextStart = prevEnd;
                }
            }
            const yyyy = nextStart.getFullYear();
            const mm = String(nextStart.getMonth() + 1).padStart(2, '0');
            const dd = String(nextStart.getDate()).padStart(2, '0');
            const startEl = document.getElementById('renew_start_date');
            if (startEl) startEl.value = `${yyyy}-${mm}-${dd}`;

            const months = parseInt(d.contractMonths) || 12;
            const monthsEl = document.getElementById('renew_contract_months');
            if (monthsEl) monthsEl.value = months;

            const totalRent = parseFloat(d.totalRent) || 0;
            const rentEl = document.getElementById('renew_total_rent');
            if (rentEl) rentEl.value = totalRent ? totalRent : '';

