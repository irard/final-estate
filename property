                        summaryRowsHtml += `
                            <tr style="border-bottom: 1px solid #e2e8f0; font-size: 13px;">
                                <td style="padding: 12px 10px; vertical-align: top; width: 45%;">
                                    <div style="font-weight: normal; color: #000; line-height: 1.5;">
                                        ${pMethod} received from ${tName}<br>
                                        &nbsp;&nbsp;&nbsp;&nbsp;Amount ${amtFmt} UAE Dirham<br>
                                        &nbsp;&nbsp;&nbsp;&nbsp;${rvDisplay ? rvDisplay + ' dt ' : ''}${pDate}
                                    </div>
                                </td>
                                <td style="padding: 12px 10px; vertical-align: top; width: 15%; color: #000;">
                                    Collected
                                </td>
                                <td style="padding: 12px 10px; vertical-align: top; text-align: right; width: 15%; font-weight: normal; color: #000;">
                                    ${amtFmt}
                                </td>
                                <td style="padding: 12px 10px; vertical-align: top; text-align: center; width: 15%; color: #000;">
