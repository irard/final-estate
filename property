if (!function_exists('ef_get_tenant_due_day')) { 
    function ef_get_tenant_due_day($t_id) { 
        $d = get_field('rent_due_day', $t_id) ?: get_field('due_day', $t_id) ?: get_post_meta($t_id, 'rent_due_day', true) ?: get_post_meta($t_id, 'due_day', true); 
        if (!$d) return 5; 
        if (is_numeric($d)) { 
            $v = intval($d); 
            if ($v >= 1 && $v <= 31) return $v; 
            if (strlen((string)$v) === 8) return intval(substr((string)$v, 6, 2)); 
        } 
        $ts = strtotime((string)$d); 
        return $ts ? intval(date('j', $ts)) : 5; 
    } 
} 
if (!function_exists('ef_is_tenant_billable')) { 
    function ef_is_tenant_billable($t_id, $m, $y) { 
        $s_str = get_field('tenant_start', $t_id) ?: get_post_meta($t_id, 'tenant_start', true); 
        $e_str = get_field('tenant_end', $t_id) ?: get_post_meta($t_id, 'tenant_end', true); 
        if (!$s_str) return true; 
 
        $dim = (int)date('t', strtotime("$y-$m-01")); 
        $month_end_str = "$y-$m-" . str_pad($dim, 2, '0', STR_PAD_LEFT); 
        $month_start_str = "$y-$m-01"; 
 
        if ($s_str > $month_end_str) return false; 
        if ($e_str && $e_str < $month_start_str) return false; 
 
        return true; 
    } 
} 

if (!function_exists('ef_get_id_from_any')) {
    function ef_get_id_from_any($val) {
        if (!$val) return 0;
        $val = maybe_unserialize($val);
        if (is_array($val)) {
            $first = reset($val);
            return ef_get_id_from_any($first);
        }
        if (is_object($val)) return intval($val->ID ?? $val->post_id ?? $val->id ?? 0);
        return intval($val);
    }
}

if (!function_exists('ef_get_dashboard_period')) {
    function ef_get_dashboard_period() {
        $m = isset($_REQUEST["ef_month"]) ? $_REQUEST["ef_month"] : (isset($_COOKIE["ef_month"]) ? $_COOKIE["ef_month"] : date("m"));
        $y = isset($_REQUEST["ef_year"]) ? $_REQUEST["ef_year"] : (isset($_COOKIE["ef_year"]) ? $_COOKIE["ef_year"] : date("Y"));
        $m = str_pad(intval($m), 2, "0", STR_PAD_LEFT);
        $y = intval($y);
        return ['m' => $m, 'y' => $y, 'period' => "$y-$m"];
    }
}

if (!function_exists('ef_clean_amount')) {
    function ef_clean_amount($val) {
        if (!$val) return 0.00;
        $v = str_replace(['AED', ' ', ','], '', (string)$val);
        return floatval($v);
    }
}

