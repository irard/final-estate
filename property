    window.efOpenEditMaintenanceModal = function(propertyId, index, fee, details, date) {
        document.getElementById('efMaintenanceModalTitle').innerText = 'Edit Maintenance Fee';
        document.getElementById('ef_m_property_id').value = propertyId;
        document.getElementById('ef_m_index').value = index;
        document.getElementById('ef_m_fee').value = fee;
        document.getElementById('ef_m_details').value = details;
        document.getElementById('ef_m_date').value = date;
        document.getElementById('efMaintenanceModal').style.display = 'flex';
    };

    window.efOpenEditMaintenanceModalFromBtn = function(btn) {
        const d = btn.dataset;
        window.efOpenEditMaintenanceModal(d.prop, d.index, d.fee, d.details, d.date);
    };

    window.efCloseMaintenanceModal = function() {
        document.getElementById('efMaintenanceModal').style.display = 'none';
    };

    window.efSubmitMaintenanceForm = function() {
        const propId = document.getElementById('ef_m_property_id').value;
        const index = parseInt(document.getElementById('ef_m_index').value, 10);
        const fee = document.getElementById('ef_m_fee').value;
        const details = document.getElementById('ef_m_details').value;
        const date = document.getElementById('ef_m_date').value;

        if (!fee || !details || !date) {
            alert('Please fill in all fields.');
            return;
        }

        const action = index >= 0 ? 'update_property_maintenance_fee' : 'add_property_maintenance_fee';
        const formData = new FormData();
        formData.append('action', action);
        const nonceEl = document.getElementById('ef_property_nonce');
        if (nonceEl) formData.append('nonce', nonceEl.value);
        formData.append('property_id', propId);
        if (index >= 0) formData.append('index', index);
        formData.append('fee', fee);
        formData.append('details', details);
        formData.append('date', date);

        const saveBtn = document.getElementById('efMaintenanceSaveBtn');
        if (saveBtn) { saveBtn.disabled = true; saveBtn.innerText = 'Saving...'; }

        const reqUrl = (typeof ajaxUrl !== 'undefined' && ajaxUrl) ? ajaxUrl : '<?php echo admin_url("admin-ajax.php"); ?>';

        fetch(reqUrl, { method: 'POST', body: formData })
            .then(r => r.json())
            .then(res => {
                if (saveBtn) { saveBtn.disabled = false; saveBtn.innerText = 'Save Fee'; }
                if (res.success) {
                    efCloseMaintenanceModal();
                    // Re-trigger property details view refresh
                    window.dispatchEvent(new CustomEvent('showPropertyDetails', { detail: { id: propId, name: document.querySelector('#properties-page-details h2')?.innerText || '' } }));
                } else {
                    alert(res.data || 'Failed to save maintenance fee.');
                }
            })
            .catch((err) => {
                console.error(err);
                if (saveBtn) { saveBtn.disabled = false; saveBtn.innerText = 'Save Fee'; }
                alert('An error occurred while saving.');
            });
    };

    window.efDeleteMaintenanceFee = function(propertyId, index) {
        if (!confirm('Are you sure you want to delete this maintenance fee?')) return;

        const formData = new FormData();
        formData.append('action', 'delete_property_maintenance_fee');
        const nonceEl = document.getElementById('ef_property_nonce');
        if (nonceEl) formData.append('nonce', nonceEl.value);
        formData.append('property_id', propertyId);
        formData.append('index', index);

        const reqUrl = (typeof ajaxUrl !== 'undefined' && ajaxUrl) ? ajaxUrl : '<?php echo admin_url("admin-ajax.php"); ?>';

        fetch(reqUrl, { method: 'POST', body: formData })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    window.dispatchEvent(new CustomEvent('showPropertyDetails', { detail: { id: propertyId, name: document.querySelector('#properties-page-details h2')?.innerText || '' } }));
                } else {
                    alert(res.data || 'Failed to delete maintenance fee.');
                }
            })
            .catch(() => alert('An error occurred.'));
    };

    if (typeof window.efDownloadTenantPDF !== 'function') {
        window.efDownloadTenantPDF = function(tenantName, tenantData, type = 'yearly') {
            const fmtMoney = amount => (parseFloat(amount) || 0).toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const fmtDateDMY = dateStr => {
                if (!dateStr || dateStr === 'N/A') return 'N/A';
                let d = new Date(dateStr);
                if (isNaN(d.getTime())) return dateStr;
                return String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0') + '/' + d.getFullYear();
            };
            const numberToWordsDirham = amount => {
                amount = parseFloat(String(amount).replace(/,/g, '')) || 0;
                const units = ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"];
                const tens = ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"];
                const convertGroup = n => {
                    let str = "";
                    if (n >= 100) {
                        str += units[Math.floor(n / 100)] + " Hundred ";
                        n %= 100;
                    }
                    if (n >= 20) {
                        str += tens[Math.floor(n / 10)] + (n % 10 ? " " + units[n % 10] : "");
                    } else if (n > 0) {
                        str += units[n];
                    }
                    return str.trim();
                };
                if (amount === 0) return "Only Zero UAE Dirham";
                let dirhams = Math.floor(amount);
                let fils = Math.round((amount - dirhams) * 100);
                let parts = [];
                if (dirhams >= 1000000) {
                    let millions = Math.floor(dirhams / 1000000);
                    dirhams %= 1000000;
                    parts.push(convertGroup(millions) + " Million");
                }
                if (dirhams >= 1000) {
                    let thousands = Math.floor(dirhams / 1000);
                    dirhams %= 1000;
                    parts.push(convertGroup(thousands) + " Thousand");
                }
                if (dirhams > 0) {
                    parts.push(convertGroup(dirhams));
                }
                let res = "Only " + parts.join(" ").trim() + " UAE Dirham";
                if (fils > 0) {
                    res += " and " + convertGroup(fils) + " Fils";
                }
                return res;
            };

            let tName = tenantName || 'Tenant';
            let prop = '';
            let unit = '1A';
            let monthlyRent = '0.00';
            let totalContract = '0.00';
            let totalContractWords = '';
            let totalPaid = '0.00';
            let remainingBalance = '0.00';
            let paymentsCount = '0';
            let email = 'None';
            let phone = 'None';
            let address = 'No Address Provided';
            let contractStart = 'N/A';
            let contractEnd = 'N/A';
            let statusLabel = 'Contract active';
            let payments = [];

            if (tenantData) {
                tName = tenantData.name || tName;
                prop = tenantData.property_name || '';
                unit = tenantData.unit || '1A';
                monthlyRent = fmtMoney(tenantData.monthly_rent);
                totalContract = fmtMoney(tenantData.total_contract);
                totalPaid = fmtMoney(tenantData.total_paid);
                remainingBalance = fmtMoney(tenantData.balance);
                email = tenantData.email || 'None';
                phone = tenantData.phone || 'None';
                address = tenantData.address || 'No Address Provided';
                contractStart = tenantData.start_date || 'N/A';
                contractEnd = tenantData.end_date || 'N/A';
                statusLabel = (tenantData.status === 'finished') ? 'tenant contract ended' : 'Contract active';
                payments = tenantData.payments || [];
                paymentsCount = String(payments.length);
            }

            const initials = tName.split(' ').map(w => w.charAt(0).toUpperCase()).join('').substring(0, 2) || 'SR';

            const today = new Date();
            const requestDate = String(today.getDate()).padStart(2, '0') + '/' + String(today.getMonth() + 1).padStart(2, '0') + '/' + today.getFullYear();
            const printTimeStr = today.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', second: '2-digit', hour12: true });

            let pdfHtml = '';

            if (type === 'summary') {
                let summaryRowsHtml = '';
                let calcTotalPaid = 0;
                if (payments.length > 0) {
                    payments.forEach((p) => {
                        const rawAmt = typeof p.amount === 'number' ? p.amount : (parseFloat(String(p.amount).replace(/,/g, '')) || 0);
                        calcTotalPaid += rawAmt;
                        const amtFmt = (rawAmt % 1 === 0) ? rawAmt.toLocaleString('en-US') : rawAmt.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        const pMethod = p.method || 'Cash';
                        const pDate = fmtDateDMY(p.date || p.payment_date);
                        const rvVal = p.rv || p.receipt_voucher || p.cheque || '';
                        const rvDisplay = rvVal ? (String(rvVal).toUpperCase().startsWith('RV') ? String(rvVal) : `RV ${rvVal}`) : '';
