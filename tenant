add_action('wp_ajax_eftm_get_tenants', 'ef_handle_get_tenants');
if (!function_exists('ef_handle_get_tenants')) {
    function ef_handle_get_tenants() {
        check_ajax_referer('ef_tenant_nonce', 'nonce');
        if (!is_user_logged_in()) wp_send_json_error('Unauthorized.');
 
        $period = ef_get_dashboard_period();
        $m = $period['m'];
        $y = $period['y'];

        $tenants = get_posts([
            'post_type' => 'ef_tenant',
            'post_status' => 'publish',
            'numberposts' => -1,
            'orderby' => 'title',
            'order' => 'ASC'
        ]);

        $data = [];
        foreach ($tenants as $t) {
            $tid = $t->ID;
            $status = ef_get_tenant_monthly_status($tid, $m, $y);
            $prop_id = ef_get_tenant_property_id($tid);
            $prop_name = '';
            if ($prop_id) {
                $prop_name = (function_exists('get_field') ? (get_field('add_property', $prop_id) ?: get_field('property_name', $prop_id)) : null) ?: get_post_meta($prop_id, 'add_property', true) ?: get_post_meta($prop_id, 'property_name', true) ?: get_the_title($prop_id);
            }
            $address = (function_exists('get_field') ? get_field('tenant_address', $tid) : null) ?: get_post_meta($tid, 'tenant_address', true) ?: $prop_name;

            $data[] = [
                'id' => $tid,
                'name' => $t->post_title,
                'property_name' => $prop_name,
                'address' => $address ?: '-',
                'monthly_rent' => $status['rent'],
                'is_fully_paid' => $status['is_fully_paid']
            ];
        }

        wp_send_json_success($data);
    } 
} 
 
add_action('wp_ajax_eftm_handle_ajax_tenant_breakdown', 'ef_handle_tenant_breakdown');
if (!function_exists('ef_handle_tenant_breakdown')) {
    function ef_handle_tenant_breakdown() {
        check_ajax_referer('ef_tenant_nonce', 'nonce');
        if (!is_user_logged_in()) wp_send_json_error('Unauthorized.');
 
        $tid = intval($_POST['tenant_id'] ?? 0);
        if (!$tid) wp_send_json_error('Invalid Tenant ID');
 
        $tenant = get_post($tid);
        if (!$tenant || $tenant->post_type !== 'ef_tenant') wp_send_json_error('Tenant not found');
 
        $prop_id = ef_get_tenant_property_id($tid);
        $prop_name = '-';
        if ($prop_id) {
            $prop_name = (function_exists('get_field') ? (get_field('add_property', $prop_id) ?: get_field('property_name', $prop_id)) : null) ?: get_post_meta($prop_id, 'add_property', true) ?: get_post_meta($prop_id, 'property_name', true) ?: get_the_title($prop_id);
        }
 
        $total_contract = ef_clean_amount(get_field('total_contract_amount', $tid) ?: get_post_meta($tid, 'total_contract_amount', true) ?: get_field('total_rent_cost', $tid) ?: get_post_meta($tid, 'total_rent_cost', true));
        $monthly_rent = ef_clean_amount(get_field('monthly_rent', $tid) ?: get_post_meta($tid, 'monthly_rent', true));
        $contract_months = intval(get_field('tenant_contract_months', $tid) ?: get_post_meta($tid, 'tenant_contract_months', true) ?: get_field('contract_months', $tid) ?: get_post_meta($tid, 'contract_months', true) ?: 12);
 
        if ($total_contract <= 0 && $monthly_rent > 0) {
            $total_contract = $monthly_rent * $contract_months;
        }
 
        $tenant_start = get_field('tenant_start', $tid) ?: get_post_meta($tid, 'tenant_start', true) ?: '-';
        $tenant_end = get_field('tenant_end', $tid) ?: get_post_meta($tid, 'tenant_end', true) ?: '-';
        $tenant_email = get_field('tenant_email', $tid) ?: get_post_meta($tid, 'tenant_email', true) ?: '-';
 
        // Get payments history
        $all_payments = get_posts([
            'post_type' => 'payment',
            'post_status' => ['publish', 'future', 'pending', 'draft', 'private'],
            'numberposts' => -1
        ]);
 
        $tenant_payments = [];
        $paid_periods = [];
        foreach ($all_payments as $pay) {
            if (ef_get_payment_tenant_id($pay->ID) === $tid) {
                $amt = ef_clean_amount(get_field('amount_paid', $pay->ID) ?: get_post_meta($pay->ID, 'amount_paid', true));
                $start = get_field('cheque_start_date', $pay->ID) ?: get_post_meta($pay->ID, 'cheque_start_date', true);
                $end = get_field('cheque_end_date', $pay->ID) ?: get_post_meta($pay->ID, 'cheque_end_date', true);
                $pay_period = ef_get_payment_period($pay->ID);

                if (!isset($paid_periods[$pay_period])) $paid_periods[$pay_period] = 0;
                $paid_periods[$pay_period] += $amt;

                $period_display = ($start && $end && $start !== $end) ? "$start to $end" : ($start ?: ($end ?: $pay_period));

                $tenant_payments[] = [
                    'id' => $pay->ID,
                    'amount' => $amt,
                    'period' => $period_display,
                    'date' => get_field('date_of_payment', $pay->ID) ?: get_post_meta($pay->ID, 'date_of_payment', true) ?: get_the_date('Y-m-d', $pay->ID)
                ];
            }
        }
 
        $fully_paid_months = 0;
        foreach ($paid_periods as $period => $amt) {
            if (($monthly_rent > 0 && ($amt - $monthly_rent) >= -0.001) || ($monthly_rent == 0 && $amt > 0)) {
                $fully_paid_months++;
            }
        } 

        wp_send_json_success([
            'id' => $tid,
            'name' => $tenant->post_title,
            'property_id' => $prop_id,
            'property_name' => $prop_name,
            'total_contract' => $total_contract,
            'monthly_rent' => $monthly_rent,
            'contract_months' => $contract_months,
            'tenant_start' => $tenant_start,
            'tenant_end' => $tenant_end,
            'tenant_email' => $tenant_email,
            'paid_months_count' => $fully_paid_months,
            'payments' => $tenant_payments
        ]);
    }
}

add_action('wp_ajax_save_tenant', 'ef_handle_save_tenant');
if (!function_exists('ef_handle_save_tenant')) {
    function ef_handle_save_tenant() {
        check_ajax_referer('ef_tenant_nonce', 'nonce');
        if (!is_user_logged_in()) wp_send_json_error('Unauthorized.');

        $tid = intval($_POST['tenant_id'] ?? 0);
        $name = sanitize_text_field($_POST['name'] ?? '');
        $prop_id = intval($_POST['property_id'] ?? 0);
        $total_contract = ef_clean_amount($_POST['total_contract'] ?? 0);
        $contract_months = intval($_POST['contract_months'] ?? 12);
        $monthly_rent = ($contract_months > 0) ? ($total_contract / $contract_months) : $total_contract;
        $tenant_email = sanitize_email($_POST['email'] ?? '');
        $tenant_start = sanitize_text_field($_POST['tenant_start'] ?? '');
        $tenant_end = sanitize_text_field($_POST['tenant_end'] ?? '');

        if (!$name) wp_send_json_error('Tenant name is required.');

        $post_data = [
            'post_title' => $name,
            'post_type' => 'ef_tenant',
            'post_status' => 'publish'
        ];

        if ($tid > 0) {
            $post_data['ID'] = $tid;
            $post_id = wp_update_post($post_data);
        } else {
            $post_id = wp_insert_post($post_data);
        }

        if (is_wp_error($post_id) || !$post_id) {
            wp_send_json_error('Failed to save tenant.');
        }

        if (function_exists('update_field')) {
            update_field('property_id', $prop_id, $post_id);
            update_field('property', $prop_id, $post_id);
            update_field('associated_property', $prop_id, $post_id);
            update_field('total_contract_amount', $total_contract, $post_id);
            update_field('monthly_rent', $monthly_rent, $post_id);
            update_field('tenant_contract_months', $contract_months, $post_id);
            update_field('tenant_email', $tenant_email, $post_id);
            update_field('tenant_start', $tenant_start, $post_id);
            update_field('tenant_end', $tenant_end, $post_id);
        } 
        update_post_meta($post_id, 'property_id', $prop_id);
        update_post_meta($post_id, 'associated_property', $prop_id);
        update_post_meta($post_id, 'total_contract_amount', $total_contract);
        update_post_meta($post_id, 'total_rent_cost', $total_contract);
        update_post_meta($post_id, 'contract_months', $contract_months);
        update_post_meta($post_id, 'tenant_contract_months', $contract_months);
        update_post_meta($post_id, 'monthly_rent', $monthly_rent);
        update_post_meta($post_id, 'tenant_email', $tenant_email);
        update_post_meta($post_id, 'tenant_start', $tenant_start);
        update_post_meta($post_id, 'tenant_end', $tenant_end);
 
        wp_send_json_success(['id' => $post_id]);
    } 
} 
 
