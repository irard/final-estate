if (!function_exists('ef_get_tenant_due_day')) {
    function ef_get_tenant_due_day($t_id) {
        $d = get_field('rent_due_day', $t_id) ?: get_field('due_day', $t_id) ?: get_post_meta($t_id, 'rent_due_day', true) ?: get_post_meta($t_id, 'due_day', true);
        if (!$d) return 5;
        if (is_numeric($d)) {
            $v = intval($d);
            if ($v >= 1 && $v <= 31) return $v;
            if (strlen((string)$v) === 8) return intval(substr((string)$v, 6, 2));
        }
        $ts = strtotime((string)$d);
        return $ts ? intval(date('j', $ts)) : 5;
    }
}

if (!function_exists('ef_is_tenant_billable')) {
    function ef_is_tenant_billable($t_id, $m, $y) {
        $s_str = get_field('tenant_start', $t_id) ?: get_post_meta($t_id, 'tenant_start', true);
        $e_str = get_field('tenant_end', $t_id) ?: get_post_meta($t_id, 'tenant_end', true);
        if (!$s_str) return true;

        $dd = ef_get_tenant_due_day($t_id);
        $dim = (int)date('t', strtotime("$y-$m-01"));
        $due_date_str = "$y-$m-" . str_pad(min($dd, $dim), 2, '0', STR_PAD_LEFT);

        if ($s_str > $due_date_str) return false;
        if ($e_str && $e_str < "$y-$m-01") return false;

        $start_ts = strtotime($s_str);
        $due_ts = strtotime($due_date_str);
        $diff_days = round(($due_ts - $start_ts) / (60 * 60 * 24));

        if ($diff_days < 25) return false;
        if ($e_str && $e_str < $due_date_str) return false;

        return true;
    }
}

if (!function_exists('ef_get_id_from_any')) {
    function ef_get_id_from_any($val) {
        if (!$val) return 0;
        $val = maybe_unserialize($val);
        if (is_array($val)) {
            $first = reset($val);
            return ef_get_id_from_any($first);
        }
        if (is_object($val)) return intval($val->ID ?? $val->post_id ?? $val->id ?? 0);
        return intval($val);
    }
}

if (!function_exists('ef_get_dashboard_period')) {
    function ef_get_dashboard_period() {
        $m = isset($_REQUEST["ef_month"]) ? $_REQUEST["ef_month"] : (isset($_COOKIE["ef_month"]) ? $_COOKIE["ef_month"] : date("m"));
        $y = isset($_REQUEST["ef_year"]) ? $_REQUEST["ef_year"] : (isset($_COOKIE["ef_year"]) ? $_COOKIE["ef_year"] : date("Y"));
        $m = str_pad(intval($m), 2, "0", STR_PAD_LEFT);
        $y = intval($y);
        return ['m' => $m, 'y' => $y, 'period' => "$y-$m"];
    }
}

if (!function_exists('ef_clean_amount')) {
    function ef_clean_amount($val) {
        if (!$val) return 0.00;
        $v = str_replace(['AED', ' ', ','], '', (string)$val);
        return floatval($v);
    }
}

if (!function_exists('ef_get_payment_tenant_id')) {
    function ef_get_payment_tenant_id($p_id) {
        $t = get_field('associated_tenant', $p_id) ?: get_field('select_tenant', $p_id) ?: get_post_meta($p_id, 'associated_tenant', true) ?: get_post_meta($p_id, 'select_tenant', true);
        return ef_get_id_from_any($t);
    }
}

if (!function_exists('ef_get_tenant_property_id')) {
    function ef_get_tenant_property_id($t_id) {
        $p_keys = ['property_id', 'property', 'tenant_property', 'associated_property', 'select_property', 'add_property'];
        $raw = null;
        foreach ($p_keys as $key) {
            $val = function_exists('get_field') ? get_field($key, $t_id) : null;
            if (!$val) $val = get_post_meta($t_id, $key, true);
            if ($val) {
                $raw = $val;
                break;
            }
        }
        if (!$raw) return 0;

        $raw = maybe_unserialize($raw);
        if (is_array($raw)) {
            $first = reset($raw);
            return ef_get_id_from_any($first);
        }

        $id = ef_get_id_from_any($raw);
        if ($id > 0) return $id;

        if (is_string($raw) && !is_numeric($raw)) {
            $p_clean = trim($raw);
            $found = get_posts([
                'post_type' => 'any',
                'title' => $p_clean,
                'numberposts' => 1,
                'fields' => 'ids'
            ]);
            if (!empty($found)) return intval($found[0]);
            $found_meta = get_posts([
                'post_type' => 'any',
                'meta_key' => 'add_property',
                'meta_value' => $p_clean,
                'numberposts' => 1,
                'fields' => 'ids'
            ]);
            if (!empty($found_meta)) return intval($found_meta[0]);
        }
        return 0;
    }
}

if (!function_exists('ef_get_payment_property_id')) {
    function ef_get_payment_property_id($p_id) {
        $p = get_field('associated_property', $p_id) ?: get_post_meta($p_id, 'associated_property', true);
        if (!$p) {
            $tid = ef_get_payment_tenant_id($p_id);
            if ($tid) $p = ef_get_tenant_property_id($tid);
        }
        return ef_get_id_from_any($p);
    }
}

if (!function_exists('ef_parse_any_date_to_ym')) {
    function ef_parse_any_date_to_ym($date_str) {
        if (!$date_str) return false;
        $str = trim((string)$date_str);
        if (preg_match('/^\d{8}$/', $str)) {
            return substr($str, 0, 4) . '-' . substr($str, 4, 2);
        }
        if (strpos($str, '/') !== false) {
            $parts = explode('/', $str);
            if (count($parts) === 3) {
                if (strlen($parts[0]) === 4) {
                    $y = $parts[0]; $m = $parts[1];
                } elseif (strlen($parts[2]) === 4) {
                    $y = $parts[2];
                    $m1 = intval($parts[0]); $m2 = intval($parts[1]);
                    if ($m1 > 12) {
                        $m = $parts[1];
                    } elseif ($m2 > 12) {
                        $m = $parts[0];
                    } else {
                        $m = $parts[0];
                    }
                } else {
                    $y = date('Y'); $m = $parts[0];
                }
                return $y . '-' . str_pad($m, 2, '0', STR_PAD_LEFT);
            }
        }
        if (preg_match('/^(\d{4})[-.\/](\d{1,2})/', $str, $matches)) {
            return $matches[1] . '-' . str_pad($matches[2], 2, '0', STR_PAD_LEFT);
        }
        $ts = strtotime($str);
        if ($ts) return date('Y-m', $ts);
        return false;
    }
}

if (!function_exists('ef_get_payment_period')) {
    function ef_get_payment_period($p_id) {
        $ce = get_field('cheque_end_date', $p_id) ?: get_post_meta($p_id, 'cheque_end_date', true) ?: get_field('end_date', $p_id) ?: get_post_meta($p_id, 'end_date', true);
        if ($ce) {
            $ym = ef_parse_any_date_to_ym($ce);
            if ($ym) return $ym;
        }
        $cs = get_field('cheque_start_date', $p_id) ?: get_post_meta($p_id, 'cheque_start_date', true);
        if ($cs) {
            $ym = ef_parse_any_date_to_ym($cs);
            if ($ym) return $ym;
        }
        $p = get_field('payment_period', $p_id) ?: get_post_meta($p_id, 'payment_period', true);
        if ($p) return substr((string)$p, 0, 7);
        $d = get_field('date_of_payment', $p_id) ?: get_post_meta($p_id, 'date_of_payment', true);
        if ($d) {
            $ym = ef_parse_any_date_to_ym($d);
            if ($ym) return $ym;
        }
        return get_the_date('Y-m', $p_id);
    }
}

if (!function_exists('ef_get_tenant_monthly_status')) {
    function ef_get_tenant_monthly_status($t_id, $m, $y) {
        $rent_val = get_field('monthly_rent', $t_id) ?: get_post_meta($t_id, 'monthly_rent', true);
        $rent = ef_clean_amount($rent_val);
        $period_match = "$y-$m";

        $payments = get_posts([
            'post_type' => 'payment',
            'post_status' => ['publish', 'future', 'pending', 'draft', 'private'],
            'numberposts' => -1
        ]);

        $paid = 0;
        foreach ($payments as $p) {
            $p_id = $p->ID;
            if (ef_get_payment_tenant_id($p_id) == intval($t_id)) {
                $p_period = ef_get_payment_period($p_id);
                if (strpos($p_period, $period_match) === 0) {
                    $amt_val = get_field('amount_paid', $p_id) ?: get_post_meta($p_id, 'amount_paid', true);
                    $paid += ef_clean_amount($amt_val);
                }
            }
        }

        return [
            'paid' => $paid,
            'rent' => $rent,
            'is_fully_paid' => ($rent > 0 && ($paid - $rent) >= -0.001) || ($rent == 0 && $paid > 0)
        ];
    }
} 
 
