add_action('wp_footer', function() {
?>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const ajaxUrl = '<?php echo admin_url("admin-ajax.php"); ?>';
    const listContainer = document.getElementById('efTenantCardsContainer');
    const profileContainer = document.getElementById('efTenantProfileContainer');
    const searchInput = document.getElementById('efTenantSearch');

    const firstBtn = document.getElementById('efTenantFirstPage');
    const prevBtn = document.getElementById('efTenantPrevPage');
    const nextBtn = document.getElementById('efTenantNextPage');
    const lastBtn = document.getElementById('efTenantLastPage');
    const pageInfo = document.getElementById('efTenantPageInfo');

    const modal = document.getElementById('efTenantModal');
    const btnAdd = document.getElementById('efBtnAddTenant');
    const btnClose = document.getElementById('efTenantCloseBtn');
    const btnCancel = document.getElementById('efTenantCancelBtn');
    const editForm = document.getElementById('efEditTenantForm');

    const totalContractInput = document.getElementById('modal_field_total_contract');
    const contractMonthsInput = document.getElementById('modal_field_contract_months');
    const rentInput = document.getElementById('modal_field_rent');

    const updateMonthlyRentCalc = () => {
        if (!totalContractInput || !contractMonthsInput || !rentInput) return;
        const total = parseFloat(totalContractInput.value) || 0;
        const months = parseInt(contractMonthsInput.value) || 12;
        const monthly = months > 0 ? (total / months) : 0;
        rentInput.value = 'AED ' + monthly.toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };

    if (totalContractInput) totalContractInput.addEventListener('input', updateMonthlyRentCalc);
    if (contractMonthsInput) contractMonthsInput.addEventListener('input', updateMonthlyRentCalc);

    const toggleModal = (show = true) => {
        if (!modal) return;
        if (show) {
            modal.classList.remove('properties-page-hidden');
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        } else {
            modal.classList.add('properties-page-hidden');
            modal.style.display = 'none';
            document.body.style.overflow = '';
            if (editForm) {
                editForm.reset();
                document.getElementById('modal_field_id').value = '';
                document.getElementById('efTenantModalTitle').textContent = 'Add tenant';
                document.getElementById('efTenantSubmitBtn').textContent = 'Add';
                if (rentInput) rentInput.value = '';
            } 
        }
    };

    if (btnAdd) btnAdd.onclick = () => toggleModal(true);
    if (btnClose) btnClose.onclick = () => toggleModal(false);
    if (btnCancel) btnCancel.onclick = () => toggleModal(false);

    if (editForm) {
        editForm.onsubmit = (e) => {
            e.preventDefault();
            if (!editForm.reportValidity()) return;

            const submitBtn = document.getElementById('efTenantSubmitBtn');
            const originalText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Saving...';

            const formData = new FormData();
            formData.append('action', 'save_tenant');
            const nonce = document.getElementById('ef_tenant_nonce')?.value || document.getElementById('ef_tenant_list_nonce')?.value;
            formData.append('nonce', nonce);
            formData.append('tenant_id', document.getElementById('modal_field_id').value);
            formData.append('name', document.getElementById('modal_field_name').value);
            formData.append('property_id', document.getElementById('modal_field_property').value);
            formData.append('total_contract', document.getElementById('modal_field_total_contract').value);
            formData.append('contract_months', document.getElementById('modal_field_contract_months').value);
            formData.append('email', document.getElementById('modal_field_email').value);
            formData.append('tenant_start', document.getElementById('modal_field_start').value);
            formData.append('tenant_end', document.getElementById('modal_field_end').value);

            fetch(ajaxUrl, { method: 'POST', body: formData })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    toggleModal(false);
                    loadTenants();
                } else {
                    alert(res.data || 'Failed to save tenant.');
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalText;
                }
            })
            .catch(() => {
                alert('Network error while saving tenant.');
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
            });
        };
    }
 
    let allTenants = [], curPage = 1;
    const perPage = 10;

    const getInitials = (name) => {
        if (!name) return 'T';
        const parts = name.trim().split(/\s+/);
        if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
        return name.substr(0, 2).toUpperCase();
    };

    const getFilteredTenants = () => {
        const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
        return allTenants.filter(t => {
            if (!query) return true;
            return (t.name || '').toLowerCase().includes(query) || (t.property_name || '').toLowerCase().includes(query) || (t.address || '').toLowerCase().includes(query);
        });
    };

    const loadTenantProfile = async (tenantId) => {
        if (!profileContainer) return;
        profileContainer.innerHTML = '<div style="text-align: center; color: #94a3b8; padding: 60px 0;">Loading tenant details...</div>';

        const formData = new FormData();
        formData.append('action', 'eftm_handle_ajax_tenant_breakdown');
        const nonce = document.getElementById('ef_tenant_list_nonce')?.value || document.getElementById('ef_tenant_nonce')?.value;
        formData.append('nonce', nonce);
        formData.append('tenant_id', tenantId);

        try {
            const res = await fetch(ajaxUrl, { method: 'POST', body: formData }).then(r => r.json());
            if (!res.success) {
                profileContainer.innerHTML = `<div style="color:#ef4444; padding:20px;">${res.data || 'Failed to load details'}</div>`;
                return;
            }
            const t = res.data;
            const fmt = amt => 'AED ' + (parseFloat(amt) || 0).toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            const paymentsListHtml = t.payments.length ? t.payments.map(p => `
                <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 12px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; margin-bottom:8px;">
                    <div>
                        <div style="font-weight:600; font-size:13px; color:#0f172a;">${p.period}</div>
                        <div style="font-size:11px; color:#64748b;">${p.date}</div>
                    </div>
                    <div style="font-weight:700; color:#0a8a4f; font-size:14px;">${fmt(p.amount)}</div>
                </div>
            `).join('') : '<div style="color:#94a3b8; font-size:13px; text-align:center; padding:20px 0;">No payments recorded</div>';

            profileContainer.innerHTML = `
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
                    <div>
                        <h2 style="margin:0 0 4px 0; font-size:22px; color:#0f172a;">${t.name}</h2>
                        <div style="font-size:14px; color:#64748b;">${t.property_name || '-'}</div>
                    </div>
                    <div style="display:flex; gap:8px;">
                        <button id="efEditTenantBtn" title="Edit tenant" style="padding:6px 12px; border:1px solid #cbd5e1; background:#fff; border-radius:8px; font-weight:600; cursor:pointer; font-size:15px; display:flex; align-items:center; gap:4px; box-shadow:0 1px 2px rgba(0,0,0,0.05);">✏️</button>
                        <button id="efDeleteTenantBtn" title="Delete tenant" style="padding:6px 12px; border:1px solid #fee2e2; background:#fff1f2; color:#dc2626; border-radius:8px; font-weight:600; cursor:pointer; font-size:13px; display:flex; align-items:center; gap:4px; box-shadow:0 1px 2px rgba(0,0,0,0.05);">🗑 Delete</button>
                    </div>
                </div>

                <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:12px; margin-bottom:20px;">
                    <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:12px;">
                        <small style="color:#64748b; font-size:10px; font-weight:700; text-transform:uppercase; display:block; margin-bottom:4px;">TOTAL CONTRACT AMOUNT</small>
                        <div style="font-weight:700; font-size:15px; color:#0f172a;">${fmt(t.total_contract)}</div>
                    </div>
                    <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:12px;">
                        <small style="color:#64748b; font-size:10px; font-weight:700; text-transform:uppercase; display:block; margin-bottom:4px;">MONTHLY RENT</small>
                        <div style="font-weight:700; font-size:15px; color:#0f172a;">${fmt(t.monthly_rent)}</div>
                    </div>
                    <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:12px;">
                        <small style="color:#64748b; font-size:10px; font-weight:700; text-transform:uppercase; display:block; margin-bottom:4px;">PAYMENTS</small>
                        <div style="font-weight:700; font-size:15px; color:#0a8a4f;">${t.paid_months_count} Months Paid</div>
                    </div>
                </div>

                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:14px; margin-bottom:20px;">
                    <div style="font-size:13px; font-weight:600; margin-bottom:8px; color:#0f172a;">Tenant Details</div>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:13px; color:#475569;">
                        <div><strong>Email:</strong> ${t.tenant_email}</div>
                        <div><strong>Contract Months:</strong> ${t.contract_months}</div>
                        <div><strong>Start Date:</strong> ${t.tenant_start}</div>
                        <div><strong>End Date:</strong> ${t.tenant_end}</div>
                    </div>
                </div>

                <div style="font-size:14px; font-weight:700; color:#0f172a; margin-bottom:12px;">Payment Ledger</div>
                <div style="max-height:220px; overflow-y:auto;">${paymentsListHtml}</div>
            `;

            document.getElementById('efEditTenantBtn').onclick = () => {
                document.getElementById('modal_field_id').value = t.id;
                document.getElementById('modal_field_name').value = t.name;
                document.getElementById('modal_field_property').value = t.property_id || '';
                document.getElementById('modal_field_total_contract').value = t.total_contract;
                document.getElementById('modal_field_contract_months').value = t.contract_months;
                document.getElementById('modal_field_email').value = t.tenant_email !== '-' ? t.tenant_email : '';
                document.getElementById('modal_field_start').value = t.tenant_start !== '-' ? t.tenant_start : '';
                document.getElementById('modal_field_end').value = t.tenant_end !== '-' ? t.tenant_end : '';
                updateMonthlyRentCalc();

                document.getElementById('efTenantModalTitle').textContent = 'Edit tenant';
                document.getElementById('efTenantSubmitBtn').textContent = 'Save Changes';
                toggleModal(true);
            };

            document.getElementById('efDeleteTenantBtn').onclick = () => {
                if (confirm('Are you sure you want to delete this tenant?')) {
                    const formData = new FormData();
                    formData.append('action', 'delete_tenant');
                    const nonce = document.getElementById('ef_tenant_list_nonce')?.value || document.getElementById('ef_tenant_nonce')?.value;
                    formData.append('nonce', nonce);
                    formData.append('tenant_id', t.id);

                    fetch(ajaxUrl, { method: 'POST', body: formData })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            window._activeTenantId = null;
                            loadTenants();
                            profileContainer.innerHTML = '<div style="text-align: center; color: #94a3b8; padding: 60px 0;"><p style="margin: 0; font-size: 15px; font-weight: 500;">Select a tenant to view details</p></div>';
                        } else {
                            alert(res.data || 'Failed to delete tenant.');
                        }
                    })
                    .catch(() => alert('Network error deleting tenant.'));
                }
            };
        } catch (err) {
            profileContainer.innerHTML = '<div style="color:#ef4444; padding:20px;">Network error loading profile</div>';
        }
    };

    const renderTenants = () => {
        if (!listContainer) return;
        const filtered = getFilteredTenants();
        const totalPages = Math.ceil(filtered.length / perPage) || 1;
        if (curPage > totalPages) curPage = totalPages;
        if (curPage < 1) curPage = 1;

        const start = (curPage - 1) * perPage;
        const slice = filtered.slice(start, start + perPage);

        if (slice.length === 0) {
            listContainer.innerHTML = '<div style="text-align: center; color: #94a3b8; padding: 40px 0;">No tenants found.</div>';
        } else {
            listContainer.innerHTML = slice.map(t => {
                const initials = getInitials(t.name);
                const isSelected = window._activeTenantId == t.id;

                return `
                <div class="ef-tenant-card ${isSelected ? 'active' : ''}" data-id="${t.id}" style="display:flex; align-items:center; justify-content:space-between; padding:14px 16px; border:1px solid ${isSelected ? '#0a8a4f' : '#e2e8f0'}; border-radius:10px; background:${isSelected ? '#f0fdf4' : '#ffffff'}; cursor:pointer; transition:all 0.15s ease;">
                    <div style="display:flex; align-items:center; gap:12px;">
                        <div style="width:40px; height:40px; border-radius:50%; background:#0a8a4f; color:#ffffff; font-weight:700; font-size:14px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                            ${initials}
                        </div>
                        <div>
                            <div style="font-weight:700; font-size:14px; color:#0f172a; margin-bottom:2px;">${t.name}</div>
                            <div style="font-size:12px; color:#64748b;">${t.property_name ? t.property_name + (t.address && t.address !== t.property_name ? ' · ' + t.address : '') : (t.address || '-')}</div>
                        </div>
                    </div>
                </div>
                `;
            }).join('');
        }

        Array.from(listContainer.querySelectorAll('.ef-tenant-card')).forEach(card => {
            card.onclick = () => {
                const id = card.getAttribute('data-id');
                window._activeTenantId = id;
                renderTenants();
                loadTenantProfile(id);
            };
        });

        if (pageInfo) pageInfo.textContent = `Page ${curPage} of ${totalPages}`;
        if (firstBtn) firstBtn.disabled = curPage === 1;
        if (prevBtn) prevBtn.disabled = curPage === 1;
        if (nextBtn) nextBtn.disabled = curPage >= totalPages;
        if (lastBtn) lastBtn.disabled = curPage >= totalPages;
    };

    const loadTenants = () => {
        if (!listContainer) return;
        const formData = new FormData();
        formData.append('action', 'eftm_get_tenants');
        const nonce = document.getElementById('ef_tenant_list_nonce')?.value || document.getElementById('ef_tenant_nonce')?.value;
        if (nonce) formData.append('nonce', nonce);

        fetch(ajaxUrl, { method: 'POST', body: formData })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                allTenants = res.data;
                renderTenants();
                if (allTenants.length > 0 && !window._activeTenantId) {
                    window._activeTenantId = allTenants[0].id;
                    renderTenants();
                    loadTenantProfile(allTenants[0].id);
                }
            } else {
                listContainer.innerHTML = `<div style="text-align: center; color: #ef4444; padding: 40px 0;">Failed to load tenants: ${res.data || 'Unknown error'}</div>`;
            }
        })
        .catch(() => {
            listContainer.innerHTML = '<div style="text-align: center; color: #ef4444; padding: 40px 0;">Network error loading tenants.</div>';
        }); 
    };

    if (searchInput) {
        searchInput.oninput = () => {
            curPage = 1;
            renderTenants();
        };
    }

    if (firstBtn) firstBtn.onclick = () => { if (curPage > 1) { curPage = 1; renderTenants(); } };
    if (prevBtn) prevBtn.onclick = () => { if (curPage > 1) { curPage--; renderTenants(); } };
    if (nextBtn) nextBtn.onclick = () => { const total = Math.ceil(getFilteredTenants().length / perPage) || 1; if (curPage < total) { curPage++; renderTenants(); } };
    if (lastBtn) lastBtn.onclick = () => { const total = Math.ceil(getFilteredTenants().length / perPage) || 1; if (curPage < total) { curPage = total; renderTenants(); } };

    loadTenants();
});
</script>
<?php
});
