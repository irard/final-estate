if (!function_exists('ef_parse_any_date_to_ym')) {
    function ef_parse_any_date_to_ym($date_str) {
        if (!$date_str) return false;
        $str = trim((string)$date_str);
        if (preg_match('/^\d{8}$/', $str)) {
            return substr($str, 0, 4) . '-' . substr($str, 4, 2);
        }
        if (strpos($str, '/') !== false) {
            $parts = explode('/', $str);
            if (count($parts) === 3) {
                if (strlen($parts[0]) === 4) {
                    $y = $parts[0]; $m = $parts[1];
                } elseif (strlen($parts[2]) === 4) {
                    $y = $parts[2];
                    $m1 = intval($parts[0]); $m2 = intval($parts[1]);
                    if ($m1 > 12) {
                        $m = $parts[1];
                    } elseif ($m2 > 12) {
                        $m = $parts[0];
                    } else {
                        $m = $parts[1];
                    }
                } else {
                    $y = date('Y'); $m = $parts[0];
                }
                return $y . '-' . str_pad($m, 2, '0', STR_PAD_LEFT);
            }
        }
        if (preg_match('/^(\d{4})[-.\/](\d{1,2})/', $str, $matches)) {
            return $matches[1] . '-' . str_pad($matches[2], 2, '0', STR_PAD_LEFT);
        }
        $ts = strtotime($str);
        if ($ts) return date('Y-m', $ts);
        return false;
    }
}

if (!function_exists('ef_get_payment_report_period')) {
    function ef_get_payment_report_period($p_id) {
        $cs = get_field('cheque_start_date', $p_id) ?: get_post_meta($p_id, 'cheque_start_date', true) ?: get_field('start_date', $p_id) ?: get_post_meta($p_id, 'start_date', true);
        if ($cs) {
            $ym = ef_parse_any_date_to_ym($cs);
            if ($ym) return $ym;
        }
        $ce = get_field('cheque_end_date', $p_id) ?: get_post_meta($p_id, 'cheque_end_date', true) ?: get_field('end_date', $p_id) ?: get_post_meta($p_id, 'end_date', true);
        if ($ce) {
            $ym = ef_parse_any_date_to_ym($ce);
            if ($ym) return $ym;
        }
        $p = get_field('payment_period', $p_id) ?: get_post_meta($p_id, 'payment_period', true);
        if ($p) return substr((string)$p, 0, 7);
        $d = get_field('date_of_payment', $p_id) ?: get_post_meta($p_id, 'date_of_payment', true);
        if ($d) {
            $ym = ef_parse_any_date_to_ym($d);
            if ($ym) return $ym;
        }
        return get_the_date('Y-m', $p_id);
    }
}

if (!function_exists('ef_get_tenant_due_day')) {
    function ef_get_tenant_due_day($t_id) {
        $d = get_field('rent_due_day', $t_id) ?: get_field('due_day', $t_id) ?: get_post_meta($t_id, 'rent_due_day', true) ?: get_post_meta($t_id, 'due_day', true);
        if (!$d) return 5;
        if (is_numeric($d)) {
            $v = intval($d);
            if ($v >= 1 && $v <= 31) return $v;
            if (strlen((string)$v) === 8) return intval(substr((string)$v, 6, 2));
        }
        $ts = strtotime((string)$d);
        return $ts ? intval(date('j', $ts)) : 5;
    }
}
if (!function_exists('ef_is_tenant_billable')) {
    function ef_is_tenant_billable($t_id, $m, $y) {
        $s_str = get_field('tenant_start', $t_id) ?: get_post_meta($t_id, 'tenant_start', true);
        $e_str = get_field('tenant_end', $t_id) ?: get_post_meta($t_id, 'tenant_end', true);
        if (!$s_str) return true;

        $dd = ef_get_tenant_due_day($t_id);
        $dim = (int)date('t', strtotime("$y-$m-01"));
        $due_date_str = "$y-$m-" . str_pad(min($dd, $dim), 2, '0', STR_PAD_LEFT);
        
        if ($s_str > $due_date_str) return false;
        if ($e_str && $e_str < "$y-$m-01") return false;

        $start_ts = strtotime($s_str);
        $due_ts = strtotime($due_date_str);
        $diff_days = round(($due_ts - $start_ts) / (60 * 60 * 24));
        
        if ($diff_days < 25) return false;
        if ($e_str && $e_str < $due_date_str) return false;

        return true;
    }
}
